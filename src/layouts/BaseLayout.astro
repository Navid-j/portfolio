---
import { renderers as lrg } from '@astrojs/runtime-react';
import { } from '@astrojs/tailwind';
import { SITE } from '@/data/profile';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={SITE.metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    {/* Open Graph & Socials */}
    <meta property="og:title" content="Navid Jahangiri | Software Engineer" />
    <meta property="og:description" content={SITE.metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE.baseUrl || 'https://navid-j.github.io/portfolio/'} />
    <meta property="og:image" content="https://navid-j.github.io/portfolio/social-card.jpg" />
    <meta property="og:locale" content="en-US" />
    
    <title>Navid Jahangiri | Software Engineer</title>
    
    {/* JSON-LD Person Schema */}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Navid Jahangiri",
      "jobTitle": "Software Engineer",
      "alternateJobTitle": "Project Control Specialist",
      "url": "https://navid-j.github.io/portfolio/",
      "image": "https://navid-j.github.io/portfolio/social-card.jpg",
      "email": "navid.jahangiry@live.com",
      "telephone": "+98 939 628 1508",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "Iran"
      },
      "affiliation": "Self-employed / Sanat va Modiriat IRAN (SMI)",
      "sameAs": [
        "https://www.linkedin.com/in/navid-jahangiri/",
        "https://github.com/Navid-j"
      ]
    }
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" 
      rel="stylesheet"
    />
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              display: ['Space Grotesk', 'sans-serif'],
              body: ['Inter', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace'],
            },
          },
        },
      };
    </script>
    
    <style>
      :root {
        --bg-light: #F8FAFC;
        --bg-dark: #0B0F17;
        --surface-light: #FFFFFF;
        --surface-dark: #111827;
        --ink-light: #101828;
        --ink-dark: #E6EAF2;
        --muted-light: #475467;
        --muted-dark: #64748B;
        --accent: #1D63D8;
        --border-light: #E2E8F0;
        --border-dark: #1E293B;
      }
      
      @media (prefers-color-scheme: dark) {
        :root {
          --bg-light: #0B0F17;
          --bg-dark: #05070A;
          --surface-light: #111827;
          --surface-dark: #0A0E17;
          --ink-light: #F1F5F9;
          --ink-dark: #0F172A;
          --muted-light: #94A3B8;
          --muted-dark: #5A6B89;
        }
      }
      
      html {
        scroll-behavior: smooth;
      }
      
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition-duration: 0s !important; }
      }
      
      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-light);
        color: var(--ink-light);
        background-color: var(--bg-light);
        color: var(--ink-light);
      }
      
      .dark body {
        background-color: var(--bg-dark);
        color: var(--ink-dark);
      }
      
      .accent { color: var(--accent); }
      
      .section-padding {
        padding-top: 4rem;
        padding-bottom: 4rem;
      }
      
      .container {
        max-width: 72rem;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem;
        padding-right: 1rem;
      }
      
      /* Hero title styling */
      .hero-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: clamp(2.5rem, 6vw, 4rem);
        line-height: 1.1;
      }
      
      .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: var(--muted-light);
        margin-top: 1rem;
      }
      
      /* Pipeline section styling */
      .pipeline-card {
        background: var(--surface-light);
        border: 1px solid var(--border-light);
        border-radius: 0;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
      }
      
      .pipeline-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--accent);
      }
      
      .pipeline-diameter {
        font-family: 'JetBrains Mono', monospace;
        font-size: 3rem;
        font-weight: 700;
        color: var(--accent);
        line-height: 1;
      }
      
      /* Cards */
      .card {
        background: var(--surface-light);
        border: 1px solid var(--border-light);
        border-radius: 0;
        padding: 1.5rem;
        transition: all 200ms ease;
      }
      
      .card:hover {
        border-color: var(--accent);
      }
      
      /* Focus states */
      a:focus-visible, button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      
      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .fade-in { animation: none; opacity: 1; }
      }
    </style>
  </head>
  <body>
    <div class="relative">
      {/* Navigation */}
      <nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm transition-colors" style="background: var(--bg-light);">
        <div class="container max-w-7xl mx-auto flex items-center justify-between h-16 px-4">
          <a href="/" class="font-display text-xl font-bold tracking-tighter accent">
            Navid Jahangiri
          </a>
          
          <button 
            id="theme-toggle" 
            class="btn-ghost p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            aria-label="Toggle dark mode"
          >
            <svg 
              id="moon-icon" 
              class="h-6 w-6 hidden dark:block" 
              viewBox="0 0 24 24" 
              fill="currentColor"
            >
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h-2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
            <svg 
              id="sun-icon" 
              class="h-6 w-6 block" 
              viewBox="0 0 24 24" 
              fill="currentColor"
            >
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h-2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
          </button>
          
          <ul class="hidden md:flex gap-8">
            <li><a href="#about" class="text-sm font-medium hover:underline">About</a></li>
            <li><a href="#skills" class="text-sm font-medium hover:underline">Skills</a></li>
            <li><a href="#experience" class="text-sm font-medium hover:underline">Experience</a></li>
            <li><a href="#projects" class="text-sm font-medium hover:underline">Projects</a></li>
            <li><a href="#contact" class="text-sm font-medium hover:underline">Contact</a></li>
          </ul>
        </div>
      </nav>
      
      <main class="pt-20">
        <slot />
      </main>
      
      <footer class="border-t pt-8" style="border-color: var(--border-light);">
        <div class="container max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 pt-4">
          <p class="text-sm text-[var(--muted-light)]">
            © {new Date().getFullYear()} Navid Jahangiri. All rights reserved.
          </p>
          <div class="flex gap-6">
            <a 
              href="mailto:navid.jahangiry@live.com" 
              class="text-[var(--muted-light)] hover:underline"
              aria-label="Email"
            >
              navid.jahangiry@live.com
            </a>
            <a 
              href="https://www.linkedin.com/in/navid-jahangiri/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-[var(--muted-light)] hover:underline"
              aria-label="LinkedIn"
            >
              LinkedIn
            </a>
            <a 
              href="https://github.com/Navid-j" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-[var(--muted-light)] hover:underline"
              aria-label="GitHub"
            >
              GitHub
            </a>
          </div>
        </div>
      </footer>
    </div>
    
    <script>
      // Theme toggle
      const html = document.documentElement;
      const moonIcon = document.getElementById('moon-icon');
      const sunIcon = document.getElementById('sun-icon');
      
      // Check for saved theme preference or system preference
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const savedTheme = localStorage.getItem('theme');
      
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        html.classList.add('dark');
        moonIcon.classList.add('hidden');
        sunIcon.classList.remove('block');
      }
      
      document.getElementById('theme-toggle').addEventListener('click', () => {
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        moonIcon.classList.toggle('hidden', isDark);
        sunIcon.classList.toggle('block', isDark);
      });
    </script>
  </body>
</html>