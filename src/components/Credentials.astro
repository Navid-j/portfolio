---
import SectionHead from './SectionHead.astro';
import { EDUCATION, CERTIFICATIONS, LANGUAGES } from '../data/profile';

const languages = [
  { name: 'Persian', level: LANGUAGES.persian },
  { name: 'English', level: LANGUAGES.english },
];
---

<section class="section" id="credentials">
  <div class="container">
    <SectionHead code="06" title="Education &amp; Credentials" />

    <div class="cred-grid">
      <div class="cred-group reveal">
        <h3 class="cred-label">Education</h3>
        {EDUCATION.map((edu) => (
          <article class="card cred-card">
            <p class="cred-card__degree">{edu.degree}</p>
            <p class="cred-card__field">{edu.field}</p>
            <p class="cred-card__meta">
              <span>{edu.institution}</span>
              <span class="cred-card__period">{edu.period}</span>
            </p>
          </article>
        ))}
      </div>

      <div class="cred-group reveal" data-delay="1">
        <h3 class="cred-label">Certification</h3>
        {CERTIFICATIONS.map((cert) => (
          <article class="card cred-card">
            <p class="cred-card__field">{cert.title}</p>
            <p class="cred-card__meta">
              <span>{cert.issuer}</span>
              <span class="cred-card__period">{cert.issued}</span>
            </p>
          </article>
        ))}

        <h3 class="cred-label cred-label--spaced">Languages</h3>
        <dl class="lang-list">
          {languages.map((language) => (
            <div class="lang-item">
              <dt>{language.name}</dt>
              <dd>{language.level}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .cred-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }

  .cred-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cred-group > .card {
    margin: 0;
  }

  .cred-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cred-label--spaced {
    margin-top: 1.75rem;
  }

  .cred-card {
    padding: 1.25rem 1.4rem;
  }

  .cred-card__degree {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
  }

  .cred-card__field {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .cred-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
    font-size: 0.88rem;
  }

  .cred-card__period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .lang-list {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .lang-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.85rem;
  }

  .lang-item dt {
    font-weight: 600;
    font-family: var(--font-display);
  }

  .lang-item dd {
    margin: 0;
    text-align: right;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (max-width: 56em) {
    .cred-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
