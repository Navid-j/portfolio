---
import { PROFILE } from '../data/profile';

const now = new Date();
const year = now.getFullYear();
const rev = `${year}-${String(now.getMonth() + 1).padStart(2, '0')}`;
const issued = now.toLocaleString('en-US', { month: 'short', year: 'numeric' });
const { email, linkedin, github } = PROFILE.identity;

const cells = [
  { label: 'Project', value: 'Portfolio — Navid Jahangiri', wide: true },
  { label: 'Drawing no', value: 'NJ-PRT-001' },
  { label: 'Rev', value: rev },
  { label: 'Date', value: issued },
  { label: 'Scale', value: '1:1' },
  { label: 'Sheet', value: '1 of 1' },
  { label: 'Drawn by', value: 'NJ' },
];
---

<footer class="site-footer">
  <div class="container">
    <dl class="titleblock">
      {cells.map((cell) => (
        <div class={`titleblock__cell${cell.wide ? ' titleblock__cell--wide' : ''}`}>
          <dt>{cell.label}</dt>
          <dd>{cell.value}</dd>
        </div>
      ))}
    </dl>

    <div class="site-footer__inner">
      <p class="site-footer__copy">© {year} Navid Jahangiri</p>
      <ul class="site-footer__links" aria-label="Contact links">
        <li><a href={`mailto:${email}`}>Email</a></li>
        <li><a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2.25rem;
  }

  /* ---- Engineering drawing title block ---- */
  .titleblock {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.25rem, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0;
  }

  .titleblock__cell {
    background: var(--surface);
    padding: 0.65rem 0.9rem 0.7rem;
  }

  .titleblock__cell--wide {
    grid-column: span 2;
  }

  .titleblock__cell dt {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .titleblock__cell dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .site-footer__copy {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--faint);
  }

  .site-footer__links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
  }

  .site-footer__links a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 140ms ease;
  }

  .site-footer__links a:hover {
    color: var(--accent);
  }
</style>
