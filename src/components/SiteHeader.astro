---
const links = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#oil-gas', label: 'Oil & Gas' },
  { href: '#credentials', label: 'Credentials' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="#top" aria-label="Navid Jahangiri — back to top">
      <span class="brand__mark" aria-hidden="true">NJ</span>
      <span class="brand__name">Navid Jahangiri</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list" id="nav-list">
        {links.map((link) => (
          <li><a class="site-nav__link" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle color theme">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.5M19.5 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <button id="menu-toggle" class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="nav-list" aria-label="Open menu">
        <svg class="icon-bars" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1.5px solid var(--ink);
    border-radius: 7px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .brand__name {
    font-size: 0.98rem;
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--muted);
    transition: color 140ms ease;
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -0.35rem;
    height: 2px;
    background: var(--accent);
    transition: right 200ms ease;
  }

  .site-nav__link:hover::after {
    right: 0;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 8px;
    color: var(--muted);
    transition: color 140ms ease, background-color 140ms ease;
  }

  .icon-btn:hover {
    color: var(--ink);
    background: var(--accent-soft);
  }

  /* Theme icon swap: sun shown only when dark theme is active */
  .icon-sun {
    display: none;
  }

  html[data-theme='dark'] .icon-sun {
    display: block;
  }

  html[data-theme='dark'] .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    html:not([data-theme], [data-theme='light']) .icon-sun {
      display: block;
    }

    html:not([data-theme], [data-theme='light']) .icon-moon {
      display: none;
    }
  }

  .menu-btn {
    display: none;
  }

  .menu-btn .icon-close {
    display: none;
  }

  @media (max-width: 47.9375em) {
    .brand__name {
      display: none;
    }

    .menu-btn {
      display: grid;
    }

    .site-header.menu-open .menu-btn .icon-close {
      display: block;
    }

    .site-header.menu-open .menu-btn .icon-bars {
      display: none;
    }

    .site-nav {
      position: fixed;
      top: 4rem;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      display: none;
      padding: 0.5rem 0 1rem;
    }

    .site-header.menu-open .site-nav {
      display: block;
    }

    .site-nav__list {
      flex-direction: column;
      gap: 0;
      padding-inline: max(1.25rem, (100% - var(--container)) / 2 + 1.25rem);
    }

    .site-nav__link {
      display: block;
      padding: 0.7rem 0;
      font-size: 1rem;
      border-bottom: 1px solid var(--line);
    }

    .site-nav__list li:last-child .site-nav__link {
      border-bottom: none;
    }

    .site-nav__link::after {
      content: none;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const menuBtn = document.getElementById('menu-toggle');
  const navList = document.getElementById('nav-list');

  function closeMenu() {
    header?.classList.remove('menu-open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    menuBtn?.setAttribute('aria-label', 'Open menu');
  }

  menuBtn?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open');
    menuBtn.setAttribute('aria-expanded', String(Boolean(open)));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  navList?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });

  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (!localStorage.getItem('theme')) {
      document.documentElement.dataset.theme = event.matches ? 'dark' : 'light';
    }
  });
</script>
